{
  "name": "@kitsonk/kview",
  "version": "2.0.0-alpha.1",
  "nodeModulesDir": "manual",
  "exports": { "./install": "./install.ts" },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "test": "deno test -A",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "unstable": ["kv"],
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "fmt": { "lineWidth": 120, "exclude": ["**/*.svg"] },
  "exclude": ["**/_fresh/*"],
  "imports": {
    "@/": "./",
    "@deno/gfm": "jsr:@deno/gfm@^0.12.0",
    "@deno/kv-utils": "jsr:@deno/kv-utils@^0.1.4",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "@iconify-json/lucide": "npm:@iconify-json/lucide@^1.2.95",
    "@iconify/tailwind4": "npm:@iconify/tailwind4@^1.2.1",
    "@kitsonk/kv-toolbox": "jsr:@kitsonk/kv-toolbox@^0.30.0",
    "@logtape/logtape": "jsr:@logtape/logtape@^2.0.4",
    "@oak/commons": "jsr:@oak/commons@^1.0.1",
    "@preact/signals": "npm:@preact/signals@^2.8.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/expect": "jsr:@std/expect@^1.0.18",
    "@std/fmt": "jsr:@std/fmt@^1.0.9",
    "@std/html": "jsr:@std/html@^1.0.5",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.2.1",
    "@types/node": "npm:@types/node@^25.4.0",
    "daisyui": "npm:daisyui@^5.5.19",
    "fresh": "jsr:@fresh/core@^2.2.0",
    "preact": "npm:preact@^10.29.0",
    "preact-render-to-string": "npm:preact-render-to-string@^6.6.6",
    "prismjs": "npm:prismjs@^1.30.0",
    "tailwindcss": "npm:tailwindcss@^4.2.1",
    "tailwindcss-motion": "npm:tailwindcss-motion@^1.1.1",
    "vite": "npm:vite@^7.1.3"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns", "deno.unstable"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  }
}
